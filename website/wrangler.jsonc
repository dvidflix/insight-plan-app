// Deploys the website and the contact-form worker to Cloudflare:  npx wrangler deploy --config website/wrangler.jsonc
// (run  node website/publish.mjs  first, so website-dist has the latest pages).
{
  // The name of the existing Cloudflare project. Keep it to update that site; a new name makes a new project.
  "name": "wandering-unit-7588",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../website-dist",
    "binding": "ASSETS",
    // Only the form's address runs the worker. Every page and file is served straight from the uploaded files.
    "run_worker_first": ["/api/*"]
  },
  // Not secret. The API key is: set it once with  npx wrangler secret put RESEND_API_KEY --config website/wrangler.jsonc
  "vars": {
    "CONTACT_TO": "support@insight-plan.com",
    "CONTACT_FROM": "Insight Plan website <forms@insight-plan.com>"
  }
}
