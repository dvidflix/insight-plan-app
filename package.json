{
  "name": "insight-plan-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "python -m pytest scenario-engine/tests -q",
    "licenses": "node scripts/licenses.mjs",
    "build:product": "tsc -b && vite build --mode product",
    "dev:product": "vite --mode product",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=server-dist/server.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --external:node:*",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "dev:web": "vite --mode web",
    "build:web": "tsc -b && vite build --mode web --outDir dist-web"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@thatopen/components": "^3.4.8",
    "@thatopen/components-front": "^3.4.4",
    "@thatopen/fragments": "^3.4.7",
    "@thatopen/ui": "^3.4.11",
    "@thatopen/ui-obc": "^3.4.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0",
    "web-ifc": "^0.0.77",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^2.3.2",
    "vitest": "^2.1.9"
  }
}
